{
  "name": "framer-api",
  "version": "0.1.30",
  "license": "MIT",
  "type": "module",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/validate-output.mjs",
    "dev": "tsdown --watch",
    "test": "yarn :jest",
    "analyze": "tsdown && node scripts/validate-output.mjs && du -sh dist/*",
    "size": "du -sh dist/*",
    "lint": "yarn :lint . --report-unused-disable-directives --max-warnings 0",
    "clean": "rm -rf dist",
    "typecheck": "yarn :tsc --noEmit --rootDir ..",
    "check": "yarn typecheck && yarn lint",
    "prepack": "exit 0; covered by Makefile, do not change",
    "prepublish": "exit 0; covered by Makefile, do not change",
    "prepublishOnly": "echo 'Please use make for publishing' && exit 1"
  },
  "dependencies": {
    "devalue": "^5.8.1",
    "std-env": "^4.0.0"
  },
  "peerDependencies": {
    "csstype": "^3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@framer/plugin": "4.2.0-beta.0",
    "@framerjs/framer-api-devkit": "0.0.0",
    "@framerjs/shared": "1.0.0",
    "@swc/core": "1.15.3",
    "@swc/jest": "^0.2.37",
    "@types/node": "24.10.15",
    "csstype": "^3.1.1",
    "eslint-plugin-framer-studio": "1.0.0",
    "oxlint": "^1.78.0",
    "rolldown": "1.1.3",
    "tsdown": "0.22.3",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vekter": "0.0.1"
  },
  "imports": {
    "#framer-plugin/*": "../plugin-api/src/*"
  },
  "engines": {
    "node": ">=22"
  }
}